<Window x:Class="ManufacturingSimulation.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManufacturingSimulation.WPF"
        xmlns:controls="clr-namespace:ManufacturingSimulation.WPF.Views"
        mc:Ignorable="d"
        Title="Manufacturing Simulation System" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern color scheme -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#ECF0F1"/>

        <!-- Button style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success button style -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <!-- Danger button style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- GroupBox style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox style -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="White" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New Simulation" Click="MenuNewSimulation_Click"/>
                <MenuItem Header="_Load Configuration..." Click="MenuLoadConfig_Click"/>
                <MenuItem Header="_Save Configuration..." Click="MenuSaveConfig_Click"/>
                <Separator/>
                <MenuItem Header="_Export Results..." Click="MenuExportResults_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Simulation">
                <MenuItem Header="_Start" Click="MenuStartSimulation_Click"/>
                <MenuItem Header="_Pause" Click="MenuPauseSimulation_Click"/>
                <MenuItem Header="S_top" Click="MenuStopSimulation_Click"/>
                <MenuItem Header="_Reset" Click="MenuResetSimulation_Click"/>
                <Separator/>
                <MenuItem Header="_Speed Up" Click="MenuSpeedUp_Click"/>
                <MenuItem Header="Slow _Down" Click="MenuSlowDown_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show _Gantt Chart" IsCheckable="True" IsChecked="True" 
                         Click="MenuShowGantt_Click"/>
                <MenuItem Header="Show _Analytics" IsCheckable="True" IsChecked="True" 
                         Click="MenuShowAnalytics_Click"/>
                <MenuItem Header="Show _Log" IsCheckable="True" IsChecked="True" 
                         Click="MenuShowLog_Click"/>
                <Separator/>
                <MenuItem Header="_Refresh All" Click="MenuRefreshAll_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Click="MenuDocumentation_Click"/>
                <MenuItem Header="_About" Click="MenuAbout_Click"/>
            </MenuItem>
            <MenuItem Header="Orders">
                <MenuItem Header="Manage Production Orders" Click="ManageOrders_Click"/>
                <Separator/>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Routing">
                    <MenuItem Header="Routing Management" Click="RoutingManagement_Click"/>
                </MenuItem>
                <MenuItem Header="Database Administration" 
                            Click="DatabaseAdmin_Click"
                            Icon="{StaticResource DatabaseIcon}"/>
                    <MenuItem Header="Simulation Runner"/>
                    <MenuItem Header="Factory Layout"/>
                </MenuItem>
        </Menu>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="5" Background="White">

            <!-- Simulation Control Tab -->
            <TabItem Header="Simulation Control">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Configuration and Controls -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Simulation Controls -->
                            <GroupBox Header="Simulation Controls">
                                <StackPanel>
                                    <Button x:Name="btnStart" Content="▶ Start Simulation" 
                                           Style="{StaticResource SuccessButton}" 
                                           Click="BtnStart_Click"/>
                                    <Button x:Name="btnPause" Content="⏸ Pause" 
                                           Style="{StaticResource ModernButton}" 
                                           Click="BtnPause_Click" IsEnabled="False"/>
                                    <Button x:Name="btnStop" Content="⏹ Stop" 
                                           Style="{StaticResource DangerButton}" 
                                           Click="BtnStop_Click" IsEnabled="False"/>
                                    <Button x:Name="btnReset" Content="↻ Reset" 
                                           Style="{StaticResource ModernButton}" 
                                           Click="BtnReset_Click"/>

                                    <Separator Margin="5,10"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Simulation Speed:" VerticalAlignment="Center" 
                                                  Margin="5,0" Width="120"/>
                                        <ComboBox x:Name="cmbSpeed" Width="150" 
                                                 SelectionChanged="CmbSpeed_SelectionChanged">
                                            <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                            <ComboBoxItem Content="1x (Normal)" Tag="1.0" IsSelected="True"/>
                                            <ComboBoxItem Content="2x" Tag="2.0"/>
                                            <ComboBoxItem Content="5x" Tag="5.0"/>
                                            <ComboBoxItem Content="10x" Tag="10.0"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Simulation Parameters -->
                            <GroupBox Header="Simulation Parameters">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Duration (hours):" VerticalAlignment="Center" 
                                                  Margin="5,0" Width="120"/>
                                        <TextBox x:Name="txtDuration" Width="150" Text="24"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Number of Jobs:" VerticalAlignment="Center" 
                                                  Margin="5,0" Width="120"/>
                                        <TextBox x:Name="txtNumberOfJobs" Width="150" Text="10"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Scheduling Mode:" VerticalAlignment="Center" 
                                                  Margin="5,0" Width="120"/>
                                        <ComboBox x:Name="cmbSchedulingMode" Width="150">
                                            <ComboBoxItem Content="FIFO" IsSelected="True"/>
                                            <ComboBoxItem Content="Priority"/>
                                            <ComboBoxItem Content="Shortest Job First"/>
                                            <ComboBoxItem Content="Earliest Due Date"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Button Content="Apply Parameters" 
                                           Style="{StaticResource ModernButton}" 
                                           Click="BtnApplyParameters_Click" 
                                           Margin="5,10,5,5"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Current Status -->
                            <GroupBox Header="Current Status">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="State:" 
                                              Margin="5" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtState" 
                                              Text="Not Started" Margin="5"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sim. Time:" 
                                              Margin="5" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtSimTime" 
                                              Text="00:00:00" Margin="5"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Jobs Completed:" 
                                              Margin="5" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtJobsCompleted" 
                                              Text="0 / 0" Margin="5"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Active Tasks:" 
                                              Margin="5" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtActiveTasks" 
                                              Text="0" Margin="5"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Efficiency:" 
                                              Margin="5" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtEfficiency" 
                                              Text="0.0%" Margin="5"/>
                                </Grid>
                            </GroupBox>

                            <!-- Resource Utilization -->
                            <GroupBox Header="Resource Utilization">
                                <ListView x:Name="lstResourceUtilization" Height="150">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Resource" Width="120" 
                                                          DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="Status" Width="80" 
                                                          DisplayMemberBinding="{Binding Status}"/>
                                            <GridViewColumn Header="Utilization" Width="80" 
                                                          DisplayMemberBinding="{Binding Utilization}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Panel - Event Log -->
                    <GroupBox Grid.Column="1" Header="Event Log" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="lstEventLog" Grid.Row="0" 
                                    FontFamily="Consolas" FontSize="11"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                                <Button Content="Clear Log" Click="BtnClearLog_Click" 
                                       Style="{StaticResource ModernButton}"/>
                                <Button Content="Export Log" Click="BtnExportLog_Click" 
                                       Style="{StaticResource ModernButton}"/>
                                <CheckBox x:Name="chkAutoScroll" Content="Auto-scroll" 
                                         IsChecked="True" VerticalAlignment="Center" 
                                         Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Gantt Chart Tab -->

            <!-- Factory Layout Tab - NEW -->
            <TabItem Header="Factory Layout">
                <controls:FactoryLayoutView/>
            </TabItem>

            <!-- Analytics Tab -->
            <TabItem Header="Analytics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- KPI Dashboard -->
                        <GroupBox Header="Key Performance Indicators">
                            <UniformGrid Rows="2" Columns="3" Margin="10">
                                <!-- Throughput -->
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                       Margin="5" Padding="15" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="Throughput" FontSize="14" 
                                                  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtThroughput" Text="0.00 jobs/hr" 
                                                  FontSize="24" FontWeight="Bold" 
                                                  Foreground="{StaticResource AccentBrush}" 
                                                  HorizontalAlignment="Center" Margin="0,10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Average Lead Time -->
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                       Margin="5" Padding="15" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="Avg Lead Time" FontSize="14" 
                                                  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtAvgLeadTime" Text="0.00 hrs" 
                                                  FontSize="24" FontWeight="Bold" 
                                                  Foreground="{StaticResource SuccessBrush}" 
                                                  HorizontalAlignment="Center" Margin="0,10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Overall Efficiency -->
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                       Margin="5" Padding="15" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="Overall Efficiency" FontSize="14" 
                                                  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtOverallEfficiency" Text="0.00%" 
                                                  FontSize="24" FontWeight="Bold" 
                                                  Foreground="{StaticResource WarningBrush}" 
                                                  HorizontalAlignment="Center" Margin="0,10"/>
                                    </StackPanel>
                                </Border>

                                <!-- WIP -->
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                       Margin="5" Padding="15" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="Work In Progress" FontSize="14" 
                                                  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtWIP" Text="0" 
                                                  FontSize="24" FontWeight="Bold" 
                                                  Foreground="{StaticResource PrimaryBrush}" 
                                                  HorizontalAlignment="Center" Margin="0,10"/>
                                    </StackPanel>
                                </Border>

                                <!-- On-Time Delivery -->
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                       Margin="5" Padding="15" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="On-Time Delivery" FontSize="14" 
                                                  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtOnTimeDelivery" Text="0.00%" 
                                                  FontSize="24" FontWeight="Bold" 
                                                  Foreground="{StaticResource SuccessBrush}" 
                                                  HorizontalAlignment="Center" Margin="0,10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bottleneck -->
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                       Margin="5" Padding="15" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="Primary Bottleneck" FontSize="14" 
                                                  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtBottleneck" Text="N/A" 
                                                  FontSize="18" FontWeight="Bold" 
                                                  Foreground="{StaticResource DangerBrush}" 
                                                  HorizontalAlignment="Center" Margin="0,10"
                                                  TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </GroupBox>

                        <!-- Detailed Metrics -->
                        <GroupBox Header="Detailed Metrics">
                            <DataGrid x:Name="dgMetrics" AutoGenerateColumns="True" 
                                     IsReadOnly="True" Height="300" Margin="5"/>
                        </GroupBox>

                        <!-- Charts Placeholder -->
                        <GroupBox Header="Performance Charts">
                            <StackPanel Margin="10">
                                <TextBlock Text="Chart visualization area" 
                                          FontSize="14" Foreground="#7F8C8D" 
                                          HorizontalAlignment="Center" Margin="20"/>
                                <TextBlock Text="(Charts can be added using LiveCharts or OxyPlot)" 
                                          FontSize="12" Foreground="#95A5A6" 
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Configuration Tab -->
            <TabItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Load Configuration">
                            <StackPanel>
                                <Button Content="Load from JSON File..." 
                                       Click="BtnLoadConfig_Click"
                                       Style="{StaticResource ModernButton}"/>
                                <Button Content="Load from Database..." 
                                       Click="BtnLoadFromDb_Click"
                                       Style="{StaticResource ModernButton}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Save Configuration">
                            <StackPanel>
                                <Button Content="Save to JSON File..." 
                                       Click="BtnSaveConfig_Click"
                                       Style="{StaticResource ModernButton}"/>
                                <Button Content="Save to Database..." 
                                       Click="BtnSaveToDb_Click"
                                       Style="{StaticResource ModernButton}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Configuration Editor">
                            <StackPanel>
                                <TextBlock Text="Configuration JSON:" Margin="5"/>
                                <TextBox x:Name="txtConfigEditor" 
                                        Height="400" 
                                        AcceptsReturn="True" 
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        FontFamily="Consolas" 
                                        FontSize="11"/>
                                <Button Content="Validate Configuration" 
                                       Click="BtnValidateConfig_Click"
                                       Style="{StaticResource ModernButton}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="White" BorderBrush="#BDC3C7" 
                  BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatusBar" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtProgressStatus" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="progressBar" Width="200" Height="16" 
                           Minimum="0" Maximum="100" Value="0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

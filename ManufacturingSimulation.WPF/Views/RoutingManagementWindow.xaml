<Window x:Class="ManufacturingSimulation.WPF.Views.RoutingManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Routing Management" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Card Style for Operations -->
        <Style x:Key="OperationCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Routing Management" FontSize="24" FontWeight="Bold" Foreground="#333333"/>
                    <TextBlock Text="Define and manage product manufacturing routings" 
                               FontSize="13" Foreground="#666666" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save All Changes" 
                            Command="{Binding SaveChangesCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding HasChanges}"/>
                    <Button Content="Close" 
                            Click="CloseButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Product Selection -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Products" FontSize="16" FontWeight="Bold" 
                               Foreground="#333333" Margin="0,0,0,15"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct}"
                             BorderThickness="1"
                             BorderBrush="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" Foreground="#666666" 
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Panel - Routing Details -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Product Info Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedProduct.ProductName}" 
                                       FontSize="20" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="{Binding SelectedProduct.Description}" 
                                       FontSize="13" Foreground="#666666" Margin="0,5,0,0"/>
                            <TextBlock Margin="0,10,0,0" Foreground="#666666" FontSize="13">
                                <Run Text="Total Operations:"/>
                                <Run Text="{Binding Operations.Count, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="➕ Add Operation"
                                Command="{Binding AddOperationCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Operations List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Operations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OperationCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Operation Sequence Number -->
                                            <Border Grid.Column="0" 
                                                    Background="#007ACC" 
                                                    Width="50" Height="50" 
                                                    CornerRadius="25"
                                                    Margin="0,0,15,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding OperationSeq}" 
                                                           FontSize="22" 
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Operation Details -->
                                            <StackPanel Grid.Column="1">
                                                <!-- Work Center -->
                                                <TextBlock Text="Work Center" 
                                                           FontSize="11" 
                                                           Foreground="#666666" 
                                                           Margin="0,0,0,5"/>
                                                <ComboBox ItemsSource="{Binding DataContext.WorkCenters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedWorkCenter}"
                                                          DisplayMemberPath="WorkCenterName"
                                                          Margin="0,0,0,15"
                                                          Height="32"
                                                          FontSize="14"/>

                                                <!-- Times Grid -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Cycle Time -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Cycle Time (minutes)" 
                                                                   FontSize="11" 
                                                                   Foreground="#666666" 
                                                                   Margin="0,0,0,5"/>
                                                        <TextBox Text="{Binding CycleTimeMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="32"
                                                                 FontSize="14"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="8,0"/>
                                                    </StackPanel>

                                                    <!-- Setup Time -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Setup Time (minutes)" 
                                                                   FontSize="11" 
                                                                   Foreground="#666666" 
                                                                   Margin="0,0,0,5"/>
                                                        <TextBox Text="{Binding SetupTimeMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="32"
                                                                 FontSize="14"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="8,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="15,0,0,0">
                                                <Button Content="🔼" 
                                                        Command="{Binding DataContext.MoveOperationUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="Move Up"
                                                        Width="36" Height="36"
                                                        FontSize="16"
                                                        Margin="0,0,0,5"/>
                                                <Button Content="🔽" 
                                                        Command="{Binding DataContext.MoveOperationDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="Move Down"
                                                        Width="36" Height="36"
                                                        FontSize="16"
                                                        Margin="0,0,0,5"/>
                                                <Button Content="🗑️" 
                                                        Command="{Binding DataContext.DeleteOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="Delete Operation"
                                                        Width="36" Height="36"
                                                        FontSize="16"
                                                        Foreground="#D32F2F"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Select a product to view or edit its routing" 
                                   FontSize="16" 
                                   Foreground="#999999"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Run Text="Student:" Foreground="#666666"/>
                    <Run Text="{Binding CurrentStudent.FullName, FallbackValue='Not Set'}" FontWeight="Bold"/>
                </TextBlock>
                
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666666">
                    <Run Text="Status:"/>
                    <Run Text="{Binding StatusMessage, FallbackValue='Ready'}" FontWeight="SemiBold"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>

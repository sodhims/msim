<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ManufacturingSimulation.WPF.Views.Admin"
                    xmlns:vm="clr-namespace:ManufacturingSimulation.WPF.ViewModels.Admin">

    <!-- Property Editor Template Selector -->
    <local:PropertyEditorTemplateSelector x:Key="PropertyEditorSelector"
                                          StringEditorTemplate="{StaticResource StringEditorTemplate}"
                                          NumericEditorTemplate="{StaticResource NumericEditorTemplate}"
                                          BooleanEditorTemplate="{StaticResource BooleanEditorTemplate}"
                                          DateTimeEditorTemplate="{StaticResource DateTimeEditorTemplate}"
                                          ReadOnlyTemplate="{StaticResource ReadOnlyTemplate}"/>

    <!-- Read-Only Template (for PKs and system fields) -->
    <DataTemplate x:Key="ReadOnlyTemplate" DataType="{x:Type vm:PropertyViewModel}">
        <TextBlock Text="{Binding EditValue}"
                   Foreground="Gray"
                   FontStyle="Italic"
                   VerticalAlignment="Center"
                   ToolTip="This field is read-only"/>
    </DataTemplate>

    <!-- String Editor Template -->
    <DataTemplate x:Key="StringEditorTemplate" DataType="{x:Type vm:PropertyViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     VerticalAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="BorderBrush" Value="#FFC107"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Change indicator -->
            <TextBlock Grid.Column="1"
                       Text="●"
                       Foreground="#FFC107"
                       FontSize="16"
                       Margin="5,0,0,0"
                       VerticalAlignment="Center"
                       ToolTip="Field has unsaved changes">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <!-- Numeric Editor Template -->
    <DataTemplate x:Key="NumericEditorTemplate" DataType="{x:Type vm:PropertyViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     HorizontalContentAlignment="Right"
                     VerticalAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="BorderBrush" Value="#FFC107"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock Grid.Column="1"
                       Text="●"
                       Foreground="#FFC107"
                       FontSize="16"
                       Margin="5,0,0,0"
                       VerticalAlignment="Center"
                       ToolTip="Field has unsaved changes">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <!-- Boolean Editor Template (CheckBox) -->
    <DataTemplate x:Key="BooleanEditorTemplate" DataType="{x:Type vm:PropertyViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                      VerticalAlignment="Center">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="BorderBrush" Value="#FFC107"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <TextBlock Grid.Column="1"
                       Text="{Binding EditValue, StringFormat='({0})'}"
                       Foreground="Gray"
                       FontSize="11"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="●"
                       Foreground="#FFC107"
                       FontSize="16"
                       Margin="5,0,0,0"
                       VerticalAlignment="Center"
                       ToolTip="Field has unsaved changes">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <!-- DateTime Editor Template (DatePicker) -->
    <DataTemplate x:Key="DateTimeEditorTemplate" DataType="{x:Type vm:PropertyViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0"
                        SelectedDate="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                        VerticalAlignment="Center">
                <DatePicker.Style>
                    <Style TargetType="DatePicker">
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="BorderBrush" Value="#FFC107"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DatePicker.Style>
            </DatePicker>

            <TextBlock Grid.Column="1"
                       Text="●"
                       Foreground="#FFC107"
                       FontSize="16"
                       Margin="5,0,0,0"
                       VerticalAlignment="Center"
                       ToolTip="Field has unsaved changes">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

</ResourceDictionary>

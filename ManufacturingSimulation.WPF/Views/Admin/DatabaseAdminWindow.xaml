<Window x:Class="ManufacturingSimulation.WPF.Views.Admin.DatabaseAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Database Administration" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Modern Color Scheme -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC107"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#FAFAFA"/>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Delete Button Style -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save Button Style -->
        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TreeView Style -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="5,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Database Administration" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="13" 
                               Foreground="White" 
                               Opacity="0.9"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Student: " 
                               Foreground="White" 
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding CurrentStudentName}" 
                               Foreground="White" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <CheckBox Content="Show All Students" 
                              IsChecked="{Binding ShowAllStudents}"
                              Foreground="White"
                              Margin="20,0,0,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsAdminUser, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar - Table Navigation -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" 
                               Text="Tables" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Margin="5,0,0,10"/>

                    <!-- Search Box -->
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BorderBrush}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="8,6"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <!-- Watermark would go here with attached property -->
                    </TextBox>

                    <!-- Table Tree -->
                    <TreeView ItemsSource="{Binding TableCategories}"
                              BorderThickness="0"
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Tables}">
                                <TextBlock Text="{Binding CategoryName}" 
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="0,5"/>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                                                    Cursor="Hand"
                                                    Margin="0,2">
                                            <TextBlock Text="📋" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                            <TextBlock Text="{Binding RecordCount, StringFormat=' ({0})'}"
                                                       Foreground="Gray"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <!-- Handle selection -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Right Side - Data Grid and Details -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="200"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" 
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Table Info -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTableDisplayName}" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentTableRecordCount, StringFormat=' ({0} records)'}"
                                       FontSize="14"
                                       Foreground="Gray"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="➕ Add New" 
                                    Command="{Binding AddRecordCommand}"
                                    Style="{StaticResource ModernButton}"/>
                            <Button Content="🗑️ Delete" 
                                    Command="{Binding DeleteRecordCommand}"
                                    Style="{StaticResource DeleteButton}"
                                    IsEnabled="{Binding HasSelectedRecord}"/>
                            <Button Content="💾 Save Changes" 
                                    Command="{Binding SaveChangesCommand}"
                                    Style="{StaticResource SaveButton}"/>
                            <Button Content="🔄 Refresh" 
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource ModernButton}"/>
                            <Button Content="📤 Export CSV" 
                                    Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource ModernButton}"
                                    IsEnabled="{Binding HasRecords}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <Border Grid.Row="1" 
                        Margin="10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <DataGrid ItemsSource="{Binding CurrentTableData}"
                              SelectedItem="{Binding SelectedRecord}"
                              IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit Record" Command="{Binding EditRecordCommand}"/>
                                <MenuItem Header="Duplicate Record" Command="{Binding DuplicateRecordCommand}"/>
                                <Separator/>
                                <MenuItem Header="Delete Record" Command="{Binding DeleteRecordCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="2" 
                              Height="5" 
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"/>

                <!-- Detail Editor -->
                <Border Grid.Row="3" 
                        Margin="10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Background="White">
                    <GroupBox Header="Record Details" Margin="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Dynamic content will be generated here -->
                                <TextBlock Text="Select a record to view details"
                                           FontStyle="Italic"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="20"
                                           Visibility="{Binding HasSelectedRecord, Converter={StaticResource InverseBoolToVisConverter}}"/>

                                <!-- Detail Form Container -->
                                <ItemsControl ItemsSource="{Binding SelectedRecordProperties}"
                                              Visibility="{Binding HasSelectedRecord, Converter={StaticResource BoolToVisConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>

                                                <!-- Value editor based on type -->
                                                <TextBox Grid.Column="1" 
                                                        Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsReadOnly}"
                                                            Padding="8,6"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Edit Buttons -->
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right"
                                            Margin="0,20,0,0"
                                            Visibility="{Binding HasSelectedRecord, Converter={StaticResource BoolToVisConverter}}">
                                    <Button Content="Save Record" 
                                            Command="{Binding SaveRecordCommand}"
                                            Style="{StaticResource SaveButton}"
                                            Width="120"/>
                                    <Button Content="Cancel" 
                                            Command="{Binding CancelEditCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Background="Gray"
                                            Width="100"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#263238"
                Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusBarMessage}" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Database: " 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DatabasePath}" 
                               Foreground="#4CAF50" 
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                    <TextBlock Text="●" 
                               Foreground="{Binding IsConnected, Converter={StaticResource ConnectionStatusConverter}}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               ToolTip="Database Connection Status"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

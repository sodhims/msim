<Window x:Class="ManufacturingSimulation.WPF.Views.DatabaseMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES Database Manager" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <StackPanel>
                <TextBlock Text="MES Database Manager" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="Manufacturing Execution System Training" 
                           FontSize="14" 
                           Foreground="White" 
                           Opacity="0.9"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <!-- Menu Buttons -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Margin="20">

            <Button Click="ManageOrders_Click" 
                    Height="70" 
                    Width="350" 
                    Margin="0,0,0,15"
                    Background="White"
                    BorderBrush="#2196F3"
                    BorderThickness="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="30" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Manage Production Orders" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#2196F3"/>
                        <TextBlock Text="View, add, edit, and delete orders" 
                                   FontSize="11" 
                                   Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Click="RunSimulation_Click" 
                    Height="70" 
                    Width="350" 
                    Margin="0,0,0,15"
                    Background="White"
                    BorderBrush="#4CAF50"
                    BorderThickness="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶️" FontSize="30" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Run Simulation" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"/>
                        <TextBlock Text="Select orders and run predictive simulation" 
                                   FontSize="11" 
                                   Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- NEW: Factory Layout Button -->
            <Button Click="FactoryLayout_Click" 
                    Height="70" 
                    Width="350" 
                    Margin="0,0,0,15"
                    Background="White"
                    BorderBrush="#FF9800"
                    BorderThickness="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏭" FontSize="30" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Factory Layout" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#FF9800"/>
                        <TextBlock Text="Design machine placement and distances" 
                                   FontSize="11" 
                                   Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Click="Close_Click" 
                    Content="Close" 
                    Height="40" 
                    Width="150" 
                    Margin="0,20,0,0"
                    Background="#9E9E9E"
                    Foreground="White"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>

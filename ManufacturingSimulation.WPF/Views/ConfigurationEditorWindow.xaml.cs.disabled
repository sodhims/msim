        #endregion

        #region Apply/Cancel

        private void BtnApply_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                ResultConfiguration = BuildConfigurationFromUI();
                WasApplied = true;
                UpdateStatus("Configuration applied");
                DialogResult = true;
                Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error applying configuration: {ex.Message}", 
                    "Error", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void BtnCancel_Click(object sender, RoutedEventArgs e)
        {
            WasApplied = false;
            DialogResult = false;
            Close();
        }

        #endregion

        #region Helper Methods

        private SimulationConfiguration BuildConfigurationFromUI()
        {
            var config = new SimulationConfiguration
            {
                Machines = _machines.Select(m => new MachineConfiguration
                {
                    Id = m.Id,
                    Name = m.Name,
                    BufferCapacity = m.BufferCapacity,
                    DispatchingRule = m.DispatchingRule,
                    Quantity = m.Quantity
                }).ToList(),
                
                RunLength = double.Parse(txtRunLength.Text),
                RandomSeed = int.Parse(txtRandomSeed.Text),
                NumberOfParts = int.Parse(txtNumberOfParts.Text),
                
                ArrivalDistributionType = GetSelectedDistribution(cmbArrivalDist),
                ArrivalDistributionParams = ParseDistributionParams(txtArrivalParams.Text),
                
                // Keep defaults for now
                UseStandardRoute = true
            };

            // Set standard route from machine IDs
            config.StandardRoute = _machines.Select(m => m.Id).ToList();

            return config;
        }

        private void LoadConfigurationIntoUI(SimulationConfiguration config)
        {
            _machines.Clear();
            foreach (var machine in config.Machines)
            {
                _machines.Add(new MachineConfigViewModel(machine));
            }

            txtRunLength.Text = config.RunLength.ToString();
            txtRandomSeed.Text = config.RandomSeed.ToString();
            txtNumberOfParts.Text = config.NumberOfParts.ToString();
            txtArrivalParams.Text = string.Join(", ", config.ArrivalDistributionParams);
        }

        private string GetSelectedDistribution(ComboBox comboBox)
        {
            if (comboBox.SelectedItem is ComboBoxItem item)
            {
                string content = item.Content.ToString();
                return content.Split(' ')[0]; // Get first word (distribution name)
            }
            return "Exponential";
        }

        private System.Collections.Generic.List<double> ParseDistributionParams(string text)
        {
            try
            {
                return text.Split(',')
                    .Select(s => double.Parse(s.Trim()))
                    .ToList();
            }
            catch
            {
                return new System.Collections.Generic.List<double> { 0.5 };
            }
        }

        private void UpdateStatus(string message)
        {
            txtStatus.Text = message;
        }

        private void CmbArrivalDist_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            if (lblArrivalHelp == null) return;

            string help = GetSelectedDistribution(cmbArrivalDist) switch
            {
                "Exponential" => "Rate = 0.5 (Mean inter-arrival = 2.0)",
                "Uniform" => "min, max (e.g., 1.0, 3.0)",
                "Normal" => "mean, std dev (e.g., 2.0, 0.5)",
                "Constant" => "value (e.g., 2.0)",
                _ => ""
            };

            lblArrivalHelp.Text = help;
        }

        #endregion

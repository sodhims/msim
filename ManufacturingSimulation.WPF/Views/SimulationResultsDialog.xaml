<Window x:Class="ManufacturingSimulation.WPF.Views.SimulationResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulation Results" Height="650" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Simulation Results" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <!-- Summary Stats -->
        <Border Grid.Row="1" 
                Background="#E8F5E9" 
                BorderBrush="#4CAF50" 
                BorderThickness="2" 
                CornerRadius="5" 
                Padding="15" 
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="Throughput" FontSize="11" Foreground="Gray"/>
                    <TextBlock Text="{Binding Throughput}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="Avg Flow Time" FontSize="11" Foreground="Gray"/>
                    <TextBlock Text="{Binding AvgFlowTime}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0">
                    <TextBlock Text="Parts Completed" FontSize="11" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalCompleted}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock Text="Bottleneck Work Center" FontSize="11" Foreground="Gray"/>
                    <TextBlock Text="{Binding Bottleneck}" FontSize="18" FontWeight="Bold" Foreground="#F44336"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2">
            <!-- Work Center Results -->
            <TabItem Header="Work Center Performance">
                <DataGrid ItemsSource="{Binding WorkCenterResults}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F5F5F5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Work Center" 
                                          Binding="{Binding WorkCenter.WorkCenterName}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Utilization" 
                                          Binding="{Binding UtilizationPercent, StringFormat='{}{0:F1}%'}" 
                                          Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBottleneck}" Value="True">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Parts Processed" 
                                          Binding="{Binding PartsProcessed}" 
                                          Width="120"/>
                        <DataGridTextColumn Header="Avg Queue" 
                                          Binding="{Binding AvgQueueSize, StringFormat='{}{0:F1}'}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Max Queue" 
                                          Binding="{Binding MaxQueueSize}" 
                                          Width="100"/>
                        <DataGridCheckBoxColumn Header="Bottleneck" 
                                              Binding="{Binding IsBottleneck}" 
                                              Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Order Predictions -->
            <TabItem Header="Order Completion Predictions">
                <DataGrid ItemsSource="{Binding OrderPredictions}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F5F5F5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order Number" 
                                          Binding="{Binding ProductionOrder.OrderNumber}" 
                                          Width="150"/>
                        <DataGridTextColumn Header="Product" 
                                          Binding="{Binding ProductionOrder.Product.ProductName}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Quantity" 
                                          Binding="{Binding ProductionOrder.Quantity}" 
                                          Width="80"/>
                        <DataGridTextColumn Header="Predicted Flow Time" 
                                          Binding="{Binding PredictedFlowTimeHours, StringFormat='{}{0:F1} hrs'}" 
                                          Width="150"/>
                        <DataGridTextColumn Header="Parts Completed" 
                                          Binding="{Binding PartsCompleted}" 
                                          Width="130"/>
                        <DataGridCheckBoxColumn Header="Completed" 
                                              Binding="{Binding Completed}" 
                                              Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="📊 View Flow Log" 
                    Click="ViewFlowLog_Click"
                    Width="140" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Background="#FF9800"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="Close" 
                    Width="100" 
                    Height="35"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

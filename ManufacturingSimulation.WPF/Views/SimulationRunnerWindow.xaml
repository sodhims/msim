<Window x:Class="ManufacturingSimulation.WPF.Views.SimulationRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run Simulation" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Simulation Runner" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available Orders -->
            <GroupBox Grid.Column="0" Header="Available Orders">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" 
                             ItemsSource="{Binding AvailableOrders}"
                             SelectionMode="Single"
                             x:Name="AvailableOrdersList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Product.ProductName}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="Qty: "/>
                                        <Run Text="{Binding Quantity}"/>
                                        <Run Text=" | Priority: "/>
                                        <Run Text="{Binding Priority}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding AvailableOrders.Count, StringFormat='{}Total: {0} orders'}"
                               Margin="5"
                               FontSize="11"
                               Foreground="Gray"/>
                </Grid>
            </GroupBox>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <Button Content="➡️" 
                        Command="{Binding AddOrderCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=AvailableOrdersList}"
                        Width="60" 
                        Height="40" 
                        Margin="0,0,0,10"
                        FontSize="20"/>
                <Button Content="⬅️" 
                        Command="{Binding RemoveOrderCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=SelectedOrdersList}"
                        Width="60" 
                        Height="40"
                        FontSize="20"/>
            </StackPanel>

            <!-- Selected Orders -->
            <GroupBox Grid.Column="2" Header="Orders to Simulate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" 
                             ItemsSource="{Binding SelectedOrders}"
                             SelectionMode="Single"
                             x:Name="SelectedOrdersList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Product.ProductName}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="Qty: "/>
                                        <Run Text="{Binding Quantity}"/>
                                        <Run Text=" | Priority: "/>
                                        <Run Text="{Binding Priority}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding SelectedOrders.Count, StringFormat='{}Selected: {0} orders'}"
                               Margin="5"
                               FontSize="11"
                               Foreground="Gray"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Settings -->
        <GroupBox Grid.Row="2" Header="Simulation Settings" Margin="0,15,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Duration (hours):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SimulationDuration}" Height="30" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="Random Seed:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBox Grid.Column="3" Text="{Binding RandomSeed}" Height="30" VerticalContentAlignment="Center"/>

                <Button Grid.Column="4" 
                        Content="▶️ RUN SIMULATION" 
                        Command="{Binding RunSimulationCommand}"
                        HorizontalAlignment="Right"
                        Width="200" 
                        Height="40" 
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        IsEnabled="{Binding CanRun}"/>
            </Grid>
        </GroupBox>

        <!-- Results / Status -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status Bar -->
            <Border Grid.Row="0" 
                    Background="#E3F2FD" 
                    BorderBrush="#2196F3" 
                    BorderThickness="1" 
                    Padding="10"
                    Margin="0,0,0,10">
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="13"
                           FontWeight="Bold"/>
            </Border>

            <!-- Past Runs -->
            <GroupBox Grid.Row="1" Header="Recent Simulation Runs">
                <DataGrid ItemsSource="{Binding PastRuns}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="PastRunsGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Run Date" 
                                          Binding="{Binding RunDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" 
                                          Width="150"/>
                        <DataGridTextColumn Header="Scenario" 
                                          Binding="{Binding ScenarioName}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Throughput" 
                                          Binding="{Binding Result.Throughput, StringFormat=\{0:F2\} parts/hr}" 
                                          Width="130"/>
                        <DataGridTextColumn Header="Flow Time" 
                                          Binding="{Binding Result.AvgFlowTimeHours, StringFormat=\{0:F1\} hrs}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Completed" 
                                          Binding="{Binding Result.TotalPartsCompleted}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Bottleneck" 
                                          Binding="{Binding BottleneckWorkCenter.WorkCenterName}" 
                                          Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>

<Window x:Class="ManufacturingSimulation.WPF.Views.SimulationRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulation Runner - Full Configuration" Height="850" Width="1500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Simulation Runner - Machine Configuration &amp; Order Management" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Machine Configuration Panel -->
        <GroupBox Grid.Row="1" Header="Machine Configuration (Edits Database)" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Machine Config Grid -->
                <DataGrid Grid.Row="0" 
                         ItemsSource="{Binding MachineConfigurations}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal"
                         AlternatingRowBackground="#F5F5F5"
                         Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Machine Name" 
                                          Binding="{Binding MachineName}" 
                                          Width="*" 
                                          IsReadOnly="True"/>
                        <DataGridTextColumn Header="Type" 
                                          Binding="{Binding MachineType}" 
                                          Width="150" 
                                          IsReadOnly="True"/>
                        <DataGridTextColumn Header="Quantity" 
                                          Binding="{Binding Quantity}" 
                                          Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChanged}" Value="True">
                                            <Setter Property="Background" Value="LightYellow"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Buffer Capacity" 
                                          Binding="{Binding BufferCapacity}" 
                                          Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChanged}" Value="True">
                                            <Setter Property="Background" Value="LightYellow"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Original Qty" 
                                          Binding="{Binding OriginalQuantity}" 
                                          Width="100" 
                                          IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Original Buffer" 
                                          Binding="{Binding OriginalBuffer}" 
                                          Width="110" 
                                          IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Save Button & Settings -->
                <Grid Grid.Row="1" Margin="10,10,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="💾 Save Configuration to Database" 
                            Command="{Binding SaveMachineConfigCommand}"
                            Width="250" 
                            Height="35"
                            Background="#2196F3"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Dispatch Rule:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding DispatchRules}" 
                                 SelectedItem="{Binding SelectedDispatchRule}"
                                 Width="120"
                                 Height="30"/>
                    </StackPanel>

                    <CheckBox Grid.Column="3"
                             IsChecked="{Binding EnableLogging}"
                             Content="📝 Enable Detailed Logging"
                             VerticalAlignment="Center"
                             FontWeight="Bold"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Order Selection -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available Orders -->
            <GroupBox Grid.Column="0" Header="Available Orders">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Hold Ctrl to select multiple" 
                               FontSize="11" 
                               Foreground="Blue" 
                               Margin="5"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding AvailableOrders}"
                             SelectionMode="Extended"
                             x:Name="AvailableOrdersList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Product.ProductName}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="Qty: "/>
                                        <Run Text="{Binding Quantity}"/>
                                        <Run Text=" | Priority: "/>
                                        <Run Text="{Binding Priority}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding AvailableOrders.Count, StringFormat='{}Total: {0} orders'}"
                               Margin="5"
                               FontSize="11"
                               Foreground="Gray"/>
                </Grid>
            </GroupBox>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <Button Content="➡️ Add" 
                        Command="{Binding AddSelectedOrdersCommand}"
                        Width="80" 
                        Height="40" 
                        Margin="0,0,0,10"
                        FontSize="14"/>
                <Button Content="➡️➡️ All" 
                        Command="{Binding AddAllOrdersCommand}"
                        Width="80" 
                        Height="40" 
                        Margin="0,0,0,20"
                        FontSize="14"/>
                <Button Content="⬅️ Remove" 
                        Command="{Binding RemoveSelectedOrdersCommand}"
                        Width="80" 
                        Height="40"
                        Margin="0,0,0,10"
                        FontSize="14"/>
                <Button Content="⬅️⬅️ Clear" 
                        Command="{Binding ClearOrdersCommand}"
                        Width="80" 
                        Height="40"
                        FontSize="14"/>
            </StackPanel>

            <!-- Selected Orders -->
            <GroupBox Grid.Column="2" Header="Orders to Simulate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Hold Ctrl to select multiple" 
                               FontSize="11" 
                               Foreground="Blue" 
                               Margin="5"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding SelectedOrders}"
                             SelectionMode="Extended"
                             x:Name="SelectedOrdersList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Product.ProductName}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="Qty: "/>
                                        <Run Text="{Binding Quantity}"/>
                                        <Run Text=" | Priority: "/>
                                        <Run Text="{Binding Priority}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding SelectedOrders.Count, StringFormat='{}Selected: {0} orders'}"
                               Margin="5"
                               FontSize="11"
                               Foreground="Gray"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Run Button -->
        <GroupBox Grid.Row="3" Header="Run Simulation" Margin="0,15,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Duration (hours):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SimulationDuration}" Height="30" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" Text="Random Seed:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Text="{Binding RandomSeed}" Height="30" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <Button Grid.Column="4" 
                        Content="▶️ RUN SIMULATION" 
                        Command="{Binding RunSimulationCommand}"
                        HorizontalAlignment="Right"
                        Width="220" 
                        Height="45" 
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        IsEnabled="{Binding CanRun}"/>
            </Grid>
        </GroupBox>

        <!-- Status & Results -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status Bar -->
            <Border Grid.Row="0" 
                    Background="#E3F2FD" 
                    BorderBrush="#2196F3" 
                    BorderThickness="1" 
                    Padding="10"
                    Margin="0,0,0,10">
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="12"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Past Runs -->
            <GroupBox Grid.Row="1" Header="Recent Simulation Runs (Double-click to view)">
                <DataGrid ItemsSource="{Binding PastRuns}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="PastRunsGrid_DoubleClick"
                          x:Name="PastRunsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" 
                                          Binding="{Binding RunDate, StringFormat=\{0:MM-dd HH:mm\}}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Scenario" 
                                          Binding="{Binding ScenarioName}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Status" 
                                          Binding="{Binding Status}" 
                                          Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>

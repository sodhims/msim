<Window x:Class="ManufacturingSimulation.WPF.Views.OrderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Production Order" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Production Order Details" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Form -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Order Number -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Order Number:" VerticalAlignment="Center" Margin="0,0,0,15"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OrderNumber}" Height="30" Margin="0,0,0,15"/>

            <!-- Product -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Product:" VerticalAlignment="Center" Margin="0,0,0,15"/>
            <ComboBox Grid.Row="1" Grid.Column="1" 
                      ItemsSource="{Binding Products}"
                      SelectedValue="{Binding SelectedProductId}"
                      SelectedValuePath="ProductId"
                      DisplayMemberPath="ProductName"
                      Height="30" 
                      Margin="0,0,0,15"/>

            <!-- Quantity -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Quantity:" VerticalAlignment="Center" Margin="0,0,0,15"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Quantity}" Height="30" Margin="0,0,0,15"/>

            <!-- Due Date -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Due Date:" VerticalAlignment="Center" Margin="0,0,0,15"/>
            <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding DueDate}" Height="30" Margin="0,0,0,15"/>

            <!-- Priority -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Priority:" VerticalAlignment="Center" Margin="0,0,0,15"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Priority}" Height="30" Margin="0,0,0,15"/>

            <!-- Status -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Status:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" 
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding Status}"
                      Height="30"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="Save" 
                    Command="{Binding SaveCommand}"
                    Click="SaveButton_Click"
                    Width="100" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="Cancel" 
                    IsCancel="True"
                    Width="100" 
                    Height="35"
                    Background="#9E9E9E"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
